DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=xmp_db
DB_PORT=3306
APP_PORT=8021
NODE_ENV=development

# Auth / security — generate a real secret: openssl rand -hex 32
JWT_SECRET=change-me
JWT_EXPIRES=12h
AUTH_ENFORCED=true
DEV_EXPOSE_OTP=false
CORS_ORIGINS=http://localhost:5173

# Schema — dev runs sequelize.sync() automatically; production must not.
# Leave unset: sync ON unless NODE_ENV=production. Force with true / false.
DB_SYNC=

# Background sweeps (approval SLA escalation + scheduled report delivery).
# Minutes between runs; 0 disables the in-process sweeper.
SWEEP_INTERVAL_MIN=15
APPROVAL_REMINDER_LEAD_HOURS=12

# Outbound mail for scheduled reports. Without SMTP_HOST the mailer runs in
# "log mode" (prints, records a delivery row, sends nothing). Install
# `nodemailer` + set these for real delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=XMP <no-reply@xmp.local>
